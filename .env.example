# ==============================================================================
# ATELIER PLATFORM & KHUSHI MAKEUP ARTS - ENVIRONMENT TEMPLATE
# Copy this file to .env.local for local overrides.
# NOTE: Client Firebase keys are public identifiers; server secrets must never be placed here.
# ==============================================================================

# Firebase Web Client Configuration (Optional - Defaults to production project 'khushimakeuparts865')
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="khushimakeuparts865.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="khushimakeuparts865"
VITE_FIREBASE_STORAGE_BUCKET="khushimakeuparts865.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_MEASUREMENT_ID="your-measurement-id"

# Optional Gemini AI / Studio Integration
GEMINI_API_KEY="your-gemini-api-key"

# Application Deployment URL
APP_URL="https://khushimakeuparts.vercel.app"
