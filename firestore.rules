rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ───────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Role-based Master Developer check (Strictly checks token custom claims or authoritative Firestore /users/{uid} matching the master admin identity)
    function isDeveloper() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'naveen.kr.shiva@gmail.com' &&
        (
          request.auth.token.role == 'developer' ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'developer')
        );
    }

    // Checks if the user is authorized to manage a specific client tenant website
    function isTenantOwner(clientId) {
      return isSignedIn() && (
        isDeveloper() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedClientId == clientId)
      );
    }

    // ─── CLIENT TENANTS & WEBSITES ──────────────────────────────────────────

    match /clients/{clientId} {
      // Public visitors can read salon website content to view portfolios & pricing
      allow read: if true;

      // Platform developers create brand new tenant websites
      allow create: if isDeveloper();

      // Only authorized tenant owner or developer can edit website content
      // STRICT SECURITY:
      // 1. Forbid storing operational data or private staff PII in public parent document
      // 2. Prevent tenant ID reassignment/hijacking
      allow update: if isTenantOwner(clientId) &&
        (!('id' in request.resource.data) || request.resource.data.id == resource.data.id || request.resource.data.id == clientId) &&
        !request.resource.data.keys().hasAny(['appointments', 'enquiries', 'customers', 'staff_private']) &&
        (!('content' in request.resource.data) || !request.resource.data.content.keys().hasAny(['appointments', 'enquiries', 'customers', 'staff_private']));
      
      // Only platform developers can delete a client tenant
      allow delete: if isDeveloper();

      // 1. Time-slot appointments subcollection (isolated per tenant)
      match /appointments/{appointmentId} {
        // Public booking creation or tenant owner manual booking
        allow create: if isTenantOwner(clientId) || (
          request.resource.data.clientId == clientId &&
          request.resource.data.keys().hasAll(['customerName', 'customerPhone', 'serviceId', 'date', 'timeSlot', 'startMinute', 'endMinute', 'status']) &&
          request.resource.data.status in ['pending', 'confirmed']
        );

        // Only the tenant owner or developer can view customer PII, update status, or delete appointments
        allow read: if isTenantOwner(clientId);

        // Updates cannot alter the tenant ownership
        allow update: if isTenantOwner(clientId) &&
          (!('clientId' in request.resource.data) || request.resource.data.clientId == resource.data.clientId);

        allow delete: if isTenantOwner(clientId);
      }

      // 2. Deterministic atomic slot locks (concurrency protection)
      match /slot_locks/{lockId} {
        // Public visitors and transactions can read locks to verify availability
        allow read: if true;

        // Creation strictly permitted ONLY if lock document does not already exist,
        // matches the parent tenant's clientId, has required fields, and valid minute boundaries
        allow create: if !exists(/databases/$(database)/documents/clients/$(clientId)/slot_locks/$(lockId)) &&
          request.resource.data.clientId == clientId &&
          request.resource.data.appointmentId is string &&
          request.resource.data.staffId is string &&
          request.resource.data.date is string &&
          request.resource.data.blockMinute is int &&
          request.resource.data.blockMinute >= 0 &&
          request.resource.data.blockMinute < 1440;

        // Direct modification is forbidden to preserve lock integrity
        allow update: if false;

        // Only the tenant owner or developer can delete locks (upon appointment cancellation/deletion)
        allow delete: if isTenantOwner(clientId);
      }

      // 3. Anonymized busy intervals (zero customer PII - used for public conflict detection)
      match /busy_slots/{slotId} {
        allow read: if true;

        allow create: if request.resource.data.keys().hasAll(['date', 'startMinute', 'endMinute']) &&
          (!('clientId' in request.resource.data) || request.resource.data.clientId == clientId) &&
          !request.resource.data.keys().hasAny(['customerName', 'customerPhone', 'customerEmail', 'notes']);

        allow update: if isTenantOwner(clientId) &&
          (!('clientId' in request.resource.data) || !('clientId' in resource.data) || request.resource.data.clientId == resource.data.clientId);

        allow delete: if isTenantOwner(clientId);
      }

      // 4. Lead enquiries subcollection (isolated per tenant)
      match /enquiries/{enquiryId} {
        // Brides & public visitors can submit booking enquiries, or tenant owner can record them
        allow create: if isTenantOwner(clientId) || (
          request.resource.data.phone is string &&
          (('clientName' in request.resource.data) || ('name' in request.resource.data)) &&
          (!('clientId' in request.resource.data) || request.resource.data.clientId == clientId) &&
          (!('status' in request.resource.data) || request.resource.data.status in ['new', 'pending'])
        );

        // Only the tenant owner or master developer can view, update status, or delete enquiries
        allow read: if isTenantOwner(clientId);

        allow update: if isTenantOwner(clientId) &&
          (!('clientId' in request.resource.data) || !('clientId' in resource.data) || request.resource.data.clientId == resource.data.clientId);

        allow delete: if isTenantOwner(clientId);
      }

      // 4b. Customer CRM directory (isolated per tenant, private to tenant owner)
      match /customers/{customerId} {
        allow create, read, update, delete: if isTenantOwner(clientId);
      }

      // 5. Private staff operational records (internal notes, private phone, salary)
      match /staff_private/{staffId} {
        allow read, create, update, delete: if isTenantOwner(clientId);
      }

      // 6. Public staff team members subcollection (public-safe profiles)
      match /staff/{staffId} {
        allow read: if true;
        allow create, update, delete: if isTenantOwner(clientId);
      }

      // 7. Public bride review submissions
      match /pending_reviews/{reviewId} {
        allow create: if request.resource.data.keys().hasAll(['clientName', 'rating', 'reviewText']) &&
          request.resource.data.rating is int &&
          request.resource.data.rating >= 1 &&
          request.resource.data.rating <= 5 &&
          (!('status' in request.resource.data) || request.resource.data.status == 'pending');

        allow read, update, delete: if isTenantOwner(clientId);
      }
    }

    // ─── USER PROFILES & RBAC (PRIVILEGE ESCALATION SHIELD) ─────────────────

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isDeveloper());
      allow delete: if isDeveloper();

      // Normal users can only register their own profile with non-developer role and zero assigned tenant
      // Master admin bootstrap is allowed strictly for naveen.kr.shiva@gmail.com
      allow create: if isSignedIn() && (
        isDeveloper() ||
        (request.auth.uid == userId &&
         request.auth.token.email != null &&
         request.auth.token.email.lower() == 'naveen.kr.shiva@gmail.com' &&
         request.resource.data.role == 'developer' &&
         (!('assignedClientId' in request.resource.data) || request.resource.data.assignedClientId == null)) ||
        (request.auth.uid == userId &&
         request.resource.data.role != 'developer' &&
         (!('assignedClientId' in request.resource.data) || request.resource.data.assignedClientId == null) &&
         (!('permissions' in request.resource.data) || request.resource.data.permissions == null || request.resource.data.permissions == []))
      );

      // Normal users cannot change their role, assigned tenant, or grant themselves permissions
      allow update: if isSignedIn() && (
        isDeveloper() ||
        (request.auth.uid == userId &&
         (!('role' in request.resource.data) || (('role' in resource.data) && request.resource.data.role == resource.data.role)) &&
         (!('assignedClientId' in request.resource.data) || (('assignedClientId' in resource.data) && request.resource.data.assignedClientId == resource.data.assignedClientId)) &&
         (!('permissions' in request.resource.data) || (('permissions' in resource.data) && request.resource.data.permissions == resource.data.permissions)))
      );
    }

    // ─── GLOBAL SYSTEM SETTINGS & REGISTRY ──────────────────────────────────

    match /settings/{settingDoc} {
      allow read: if true;
      allow create, update, delete: if isDeveloper();
    }
  }
}
